# Copy to .env for local work. Never commit .env. Real values live only in Netlify environment variables.

# Server-side Postgres connection string for the Supabase project (Session pooler URI).
# SECRET. Build-time only. Never put this, or the Supabase service_role / secret key, in client code.
DATABASE_URL=

# "0" = launch build (index pages that pass the gate). Anything else or unset = staging (everything noindex).
NIL_STAGING=1
