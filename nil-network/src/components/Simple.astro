---
import Base from '../layouts/Base.astro';
import { getPage, pageIndexable } from '../lib/data.mjs';
const { path, crumbs, pageType, eyebrow, lede, ctx = {} } = Astro.props;
const page = await getPage(path);
const title = page?.title || Astro.props.title;
const h1 = page?.h1 || Astro.props.h1;
const description = page?.meta_description || Astro.props.description;
const indexable = page ? await pageIndexable(path) : false;
---
<Base title={title} description={description} path={path} indexable={indexable} pageType={pageType} crumbs={crumbs} ctx={ctx}>
  <section class="hero"><div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol></nav>
    <div class="eyebrow">{eyebrow}</div>
    <h1>{h1}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div></section>
  <div class="wrap"><section class="block"><slot /></section></div>
</Base>
