---
import { checkoutLink, KIT_FORM_ACTION, BLOG } from '../lib/site.mjs';
const { pageType, level, location = 'hub_footer' } = Astro.props;
---
<div class="ctaband">
  <h2>You know the rules. Now get brand ready.</h2>
  <p>Knowing what is allowed is step one. Brands choose the athlete they can count on, so the next step is showing up like a professional.</p>
  <div class="ctagrid">
    <div class="ctastep" id="get-guide">
      <div class="k">Free</div>
      <h3>5 Brands to Pitch</h3>
      <p>A free guide to the kinds of brands that hire athletes like you, and how to approach them.</p>
      <form class="guideform" action={KIT_FORM_ACTION} method="post" data-cta="lead_magnet" data-cta-location={location}>
        <label for="guide-email">Your email address</label>
        <input id="guide-email" type="email" name="email_address" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
        <button type="submit">Send me the free guide</button>
        <p class="fine">We email the guide and a short series on getting brand ready. Unsubscribe anytime.</p>
      </form>
    </div>
    <div class="ctastep">
      <div class="k">Build</div>
      <h3>The NIL Launch Kit</h3>
      <p>The guide, workbook and 8 templates that take you from first pitch to a signed, disclosed deal.</p>
      <a class="go" href={checkoutLink(pageType)} data-cta="product" data-cta-location={location}>See the Kit</a>
    </div>
    <div class="ctastep">
      <div class="k">Learn</div>
      <h3>Keep going</h3>
      <p><a class="txt" href={BLOG.mediaKit.href} data-cta="education">{BLOG.mediaKit.title}</a></p>
      <p><a class="txt" href={BLOG.disclosure.href} data-cta="education">{BLOG.disclosure.title}</a></p>
      {level === 'high_school' && <p><a class="txt" href={BLOG.whatIsNil.href} data-cta="education">{BLOG.whatIsNil.title}</a></p>}
    </div>
  </div>
</div>
