---
import Base from '../layouts/Base.astro';
import Chip from './Chip.astro';
import Refs from './Refs.astro';
import Matrix from './Matrix.astro';
import Scenarios from './Scenarios.astro';
import SourceList from './SourceList.astro';
import Cta from './Cta.astro';
import { fmtDate, fmtMonth, gateChecks } from '../lib/data.mjs';
import { SITE, STAGING } from '../lib/site.mjs';
const { hub } = Astro.props;
const { state, inst, topics, categories, scenarios, page, gate, bodies, policies, programs, contacts, sports, guidance, changeLog, watch, intel, sources, n, checked } = hub;
const isHS = inst.institution_type === 'high_school';
const level = inst.institution_type;
const dirPath = `/nil/${state.slug}/${isHS ? 'high-schools' : 'colleges'}/`;
const crumbs = [
  { name: 'NIL rules', href: '/nil/' }, { name: state.name, href: `/nil/states/${state.slug}/` },
  { name: isHS ? `${state.name} high schools` : `${state.name} colleges`, href: dirPath }, { name: inst.name, href: page.path },
];
const T = (slug) => topics.find((t) => t.slug === slug);
const status = T('nil-allowed');
const perm = topics.filter((t) => !t.info && t.slug !== 'nil-allowed');
const can = perm.filter((t) => t.answer === 'yes' || t.answer === 'yes_with_conditions');
const ask = perm.filter((t) => t.answer === 'only_with_approval');
const cannot = perm.filter((t) => t.answer === 'no');
const silent = perm.filter((t) => t.answer === 'not_addressed');
const prohibitedLayers = (T('prohibited-categories')?.layers || []).filter((l) => l.prohibited.length);
const disclosures = (T('disclosure-required')?.layers || []).filter((l) => l.disclosure);
const openConflicts = [...new Map(topics.flatMap((t) => t.layers.flatMap((l) => l.conflicts)).map((c) => [c.id, c])).values()];
const steps = guidance.filter((g) => g.block_type === 'action_step');
const parent = guidance.filter((g) => g.block_type === 'parent_guidance');
const verified = gate.last_verified_on;
const indexable = gate.index_status === 'index';
const typeLabel = isHS ? `${inst.sector === 'public' ? 'Public' : 'Private'} high school` : `${inst.sector === 'public' ? 'Public' : 'Private'} university`;
const refFor = (g) => { const t = g.topic_slug && T(g.topic_slug); return t ? t.lead : g.external || null; };
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: page.h1, url: SITE + page.path, description: page.meta_description,
  dateModified: String(checked), isPartOf: { '@type': 'WebSite', name: 'NIL Brand Academy', url: SITE + '/' },
  publisher: { '@type': 'Organization', name: 'NIL Brand Academy', parentOrganization: { '@type': 'Organization', name: 'ME3 Digital' } },
  about: { '@type': isHS ? 'HighSchool' : 'CollegeOrUniversity', name: inst.name, sameAs: inst.website_url,
    address: { '@type': 'PostalAddress', streetAddress: inst.street_address || undefined, addressLocality: inst.city, addressRegion: state.code, postalCode: inst.postal_code || undefined, addressCountry: 'US' } },
  citation: sources.filter((s) => s.is_primary).map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
}];
const sportList = [...new Map(sports.map((s) => [s.slug, s])).values()];
---
<Base title={page.title} description={page.meta_description} path={page.path} indexable={indexable} pageType={page.page_type} crumbs={crumbs} jsonld={jsonld}
  ctx={{ state: state.code, school: inst.slug, level, publication_state: inst.publication_state }}>
  <section class="hero"><div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol></nav>
    <div class="eyebrow">{isHS ? 'High school' : 'College'} NIL intelligence hub</div>
    <h1>{page.h1}</h1>
    <p class="lede"><strong>Can athletes at {inst.name} do NIL?</strong> {status.lead.summary}</p>
    <div class="meta">
      {verified
        ? <span class="pill">Last verified {fmtMonth(verified)}</span>
        : <span class="pill warn">Sources checked {fmtDate(checked)} &middot; human verification pending</span>}
      {bodies.map((b) => <span class="pill">{b.short_name}</span>)}
      {isHS && inst.district_name && <span class="pill">{inst.district_name}</span>}
    </div>
  </div></section>

  <nav class="jump" aria-label="On this page"><div class="wrap">
    <a href="#snapshot">Snapshot</a><a href="#can">Can and cannot</a><a href="#disclosure">Disclosure</a><a href="#school">School policy</a>
    <a href="#matrix">Rule matrix</a><a href="#ip">Logos, uniform, facilities</a><a href="#scenarios">Can I do this?</a>
    <a href="#plan">Action plan</a><a href="#parents">Parents</a><a href="#changes">Changes</a><a href="#sources">Sources</a>
  </div></nav>

  <div class="wrap">
  <section class="block" id="snapshot">
    <h2 class="sec">NIL snapshot</h2>
    <dl class="snap">
      <div><dt>School</dt><dd>{inst.name}<small><a class="ref" href={inst.website_url} rel="noopener nofollow" target="_blank">Official site</a></small></dd></div>
      <div><dt>Location</dt><dd>{inst.city}, {state.name}{inst.county && <small>{inst.county}</small>}</dd></div>
      <div><dt>School type</dt><dd>{typeLabel}{isHS && inst.district_name && <small>{inst.district_name}</small>}</dd></div>
      <div><dt>Governing bodies</dt><dd>{bodies.map((b) => b.short_name).join(', ')}{!isHS && <small>Plus Florida law</small>}</dd></div>
      <div><dt>{isHS ? 'Membership' : 'Division and conference'}</dt><dd>{inst.division}{inst.conference_name && <small>{inst.conference_name}</small>}</dd></div>
      <div><dt>NIL status</dt><dd><Chip answer={status.answer} /><small>{verified ? `Last verified ${fmtDate(verified)}` : `Sources checked ${fmtDate(checked)}`}</small></dd></div>
    </dl>
    {sportList.length > 0 && <p style="margin-top:14px;font-size:15px"><b>Sports:</b> {sportList.map((s, i) => (<><a class="ref" href={`/nil/sports/${s.slug}/`}>{s.name}</a>{i < sportList.length - 1 ? ', ' : ''}</>))}</p>}
  </section>

  <section class="block" id="can">
    <h2 class="sec">What athletes at {inst.short_name || inst.name} can and cannot do</h2>
    <p class="sub">Each line is the bottom line across every rule that applies here. The numbers link to the source.</p>
    <div class="grid2">
      <div class="card can"><h3>You can</h3>
        <ul class="tick">{can.map((t) => <li><b>{t.label}.</b> {t.lead.summary} {t.lead.verification_status === 'needs_verification' && <span class="tag">Needs verification</span>} <Refs layer={t.lead} sources={sources} /></li>)}</ul>
      </div>
      <div class="card cannot"><h3>You cannot</h3>
        <ul class="cross">
          {cannot.map((t) => <li><b>{t.label}.</b> {t.lead.summary} {t.lead.verification_status === 'needs_verification' && <span class="tag">Needs verification</span>} <Refs layer={t.lead} sources={sources} /></li>)}
          {prohibitedLayers.map((l) => <li><b>Prohibited categories ({l.issuer_name}).</b> {l.prohibited.map((p) => p.wording[0].toUpperCase() + p.wording.slice(1)).join('; ')}. <Refs layer={l} sources={sources} /></li>)}
        </ul>
      </div>
    </div>
    {(ask.length > 0 || silent.length > 0) && <div class="grid2" style="margin-top:20px">
      {ask.length > 0 && <div class="card ask"><h3>Get approval first</h3>
        <ul class="plain">{ask.map((t) => <li><b>{t.label}.</b> {t.lead.summary} {t.lead.verification_status === 'needs_verification' && <span class="tag">Needs verification</span>} <Refs layer={t.lead} sources={sources} /></li>)}</ul></div>}
      {silent.length > 0 && <div class="card"><h3>Not addressed in the rules we found</h3>
        <ul class="plain">{silent.map((t) => <li><b>{t.label}.</b> {t.lead.summary}</li>)}</ul></div>}
    </div>}
  </section>

  <section class="block" id="disclosure">
    <h2 class="sec">Disclosure requirements</h2>
    <p class="sub">What you have to report, who gets it, and how long you have.</p>
    {disclosures.map((l) => (
      <div class="disc-card">
        <div class="head">{l.issuer_name} <span>&middot; {l.citation}</span></div>
        <div class="cell"><p class="lbl">What</p><p>{l.disclosure.what}</p></div>
        <div class="cell"><p class="lbl">Who receives it</p><p>{l.disclosure.recipient}</p></div>
        <div class="cell"><p class="lbl">When</p><p>{l.disclosure.deadline_text}{l.disclosure.threshold_usd && ` (deals of $${Number(l.disclosure.threshold_usd)} or more)`}</p></div>
        <div class="foot">
          {l.disclosure.form_url && <a class="ref" href={l.disclosure.form_url} rel="noopener nofollow" target="_blank">{l.disclosure.form_name} (PDF)</a>}
          {l.disclosure.platform_url && <a class="ref" href={l.disclosure.platform_url} rel="noopener nofollow" target="_blank">{l.disclosure.platform_name}</a>}
          {' '}<Refs layer={l} sources={sources} />
          {l.conditions && <span> &middot; {l.conditions}</span>}
        </div>
      </div>
    ))}
    {disclosures.length === 0 && <div class="note">We found no disclosure rule for this school. Ask your athletic department before you sign.</div>}
  </section>

  <section class="block" id="school">
    <h2 class="sec">{inst.short_name || inst.name}'s own NIL policy</h2>
    {policies.map((p) => (
      <div class={`note ${p.policy_status === 'published' ? '' : 'warn'}`}>
        <b>{p.title}.</b> {p.summary} {p.source_slug && <span class="cite"><a href={`#source-${n(p.source_slug)}`}>[{n(p.source_slug)}]</a></span>}
      </div>
    ))}
    {programs.length > 0 && <>
      <h3 class="h3">How NIL runs at {inst.short_name || inst.name}</h3>
      <ul class="plain">{programs.map((p) => <li><b>{p.name}.</b> {p.description} {p.source_slug && <span class="cite"><a href={`#source-${n(p.source_slug)}`}>[{n(p.source_slug)}]</a></span>}</li>)}</ul>
    </>}
    <h3 class="h3" id="contact">Who to ask</h3>
    {contacts.length > 0
      ? <ul class="plain">{contacts.map((c) => <li><b>{c.office}</b>{c.person_name && `, ${c.person_name} (${c.role})`}{!c.person_name && `: ${c.role}`}.{c.phone && ` ${c.phone}.`} <a class="ref" href={c.url} rel="noopener nofollow" target="_blank">Official page</a> {c.source_slug && <span class="cite"><a href={`#source-${n(c.source_slug)}`}>[{n(c.source_slug)}]</a></span>}</li>)}</ul>
      : <p>No public NIL contact was found. Start with the athletic department.</p>}
  </section>

  <section class="block" id="matrix">
    <h2 class="sec">NIL rule matrix</h2>
    <p class="sub">Every rule that applies at {inst.name}, layer by layer. When layers differ, the strictest one sets the bottom line.</p>
    <Matrix categories={categories} sources={sources} caption={`NIL rules that apply at ${inst.name}`} />
  </section>

  <section class="block" id="ip">
    <h2 class="sec">Logos, uniform, facilities and school name</h2>
    <p class="sub">The questions brands ask first. Answers come only from the rules we could source; where the rules are silent we say so.</p>
    <Matrix categories={categories} sources={sources} caption="School marks, uniform and facility questions" ipOnly />
  </section>

  <section class="block" id="scenarios">
    <h2 class="sec">Can I do this?</h2>
    <p class="sub">Common situations, answered from the rules above. Open one to see which rule decides it.</p>
    <Scenarios scenarios={scenarios} sources={sources} />
  </section>

  {intel.length > 0 && <section class="block" id="local">
    <h2 class="sec">Local NIL opportunity intelligence</h2>
    <ul class="plain">{intel.map((i) => <li><b>{i.title}.</b> {i.body}</li>)}</ul>
  </section>}

  <section class="block" id="plan">
    <h2 class="sec">Your action plan</h2>
    <p class="sub">What to do, in order, when a brand reaches out.</p>
    <ol class="steps">
      {steps.map((g) => { const r = refFor(g); return (
        <li><h3>{g.title}</h3><p>{g.body} {r && <span class="cite">{r.citation}</span>} {r && <Refs layer={r} sources={sources} />} {g.link_url && <a class="ref" href={g.link_url} rel="noopener nofollow" target="_blank">{g.link_label}</a>}</p></li>
      ); })}
      <li><h3>Ask your school before anything unusual</h3><p>If a deal touches something on this page marked "approval required" or "not addressed", ask {contacts[0] ? contacts[0].office : 'your athletic department'} before you sign.</p></li>
    </ol>
  </section>

  {parent.length > 0 && <section class="block" id="parents">
    <h2 class="sec">For parents and guardians</h2>
    <div class="grid2">
      {parent.map((g) => { const r = refFor(g); return (
        <div class="card"><h3>{g.title}</h3><p style="margin:0">{g.body} {r && <span class="cite">{r.citation}</span>} {r && <Refs layer={r} sources={sources} />}</p></div>
      ); })}
    </div>
  </section>}

  <section class="block" id="changes">
    <h2 class="sec">What changed, and what we are watching</h2>
    {changeLog.length > 0 && <div class="tablewrap" tabindex="0" role="region" aria-label="Rule change history"><table class="log">
      <thead><tr><th scope="col">Date</th><th scope="col">Rule maker</th><th scope="col">What changed</th></tr></thead>
      <tbody>{changeLog.map((c) => <tr><td>{fmtDate(c.changed_on)}</td><td>{c.issuer}</td><td>{c.summary} {c.source_slug && <span class="cite"><a href={`#source-${n(c.source_slug)}`}>[{n(c.source_slug)}]</a></span>}</td></tr>)}</tbody>
    </table></div>}
    {watch.map((w) => <div class="note"><b>Watching: {w.title}.</b> {w.status_text} {w.summary} <span class="cite">As of {fmtDate(w.as_of)} {w.source_slug && <a href={`#source-${n(w.source_slug)}`}>[{n(w.source_slug)}]</a>}</span></div>)}
    {openConflicts.map((c) => <div class="note warn"><b>Sources differ.</b> {c.summary}</div>)}
  </section>

  <section class="block" id="sources">
    <h2 class="sec">Sources</h2>
    <p class="sub">Every rule on this page traces to one of these. <a class="ref" href="/nil/how-we-verify/">How we verify</a>.</p>
    <SourceList sources={sources} checked={checked} />
  </section>

  <section class="block" id="next">
    <Cta pageType={page.page_type} level={level} />
  </section>

  {STAGING && <section class="block" id="gate">
    <h2 class="sec">Index quality gate (staging only)</h2>
    <p class="sub">This page is <b>{gate.index_status}</b>. It enters the sitemap only when every check passes.</p>
    <ul class="gate">{gateChecks(gate).map(([label, ok]) => <li class={ok ? 'pass' : 'fail'}>{label}</li>)}</ul>
  </section>}
  </div>
</Base>
