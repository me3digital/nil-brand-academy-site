---
import Simple from '../../components/Simple.astro';
import FindSchool from '../../components/FindSchool.astro';
import { getStates } from '../../lib/data.mjs';
import { BLOG } from '../../lib/site.mjs';
const states = await getStates();
---
<Simple path="/nil/" pageType="national_hub" eyebrow="NIL intelligence network" crumbs={[{ name: 'NIL rules', href: '/nil/' }]}
  lede="Find the NIL rules for your school. Every rule is traced to its official source and dated.">
  <FindSchool heading="Find my school" />
  <h2 class="sec" style="margin-top:40px">Or start with your state</h2>
  <ul class="dir">{states.map((s) => <li><a class="card" href={`/nil/states/${s.slug}/`}><h3>{s.name} NIL rules</h3><p>High school and college rules, disclosure steps and school pages.</p></a></li>)}</ul>
  <h2 class="sec" style="margin-top:36px">Browse</h2>
  <ul class="plain">
    <li><a class="ref" href="/nil/states/">NIL rules by state</a></li>
    <li><a class="ref" href="/nil/sports/">NIL by sport</a></li>
    <li><a class="ref" href="/nil/how-we-verify/">How we check every rule</a></li>
    <li><a class="ref" href={BLOG.whatIsNil.href}>{BLOG.whatIsNil.title}</a></li>
  </ul>
</Simple>
