---
import Simple from '../../../components/Simple.astro';
import { getSports, getSport } from '../../../lib/data.mjs';
export async function getStaticPaths() { return (await getSports()).map((s) => ({ params: { sport: s.slug } })); }
const { sport, schools } = await getSport(Astro.params.sport);
const path = `/nil/sports/${sport.slug}/`;
---
<Simple path={path} pageType="sport_hub" eyebrow="NIL by sport" title={`${sport.name} NIL: Schools and Rules | NIL Brand Academy`} h1={`${sport.name} NIL`}
  description={`Schools in the NIL Brand Academy network that offer ${sport.name.toLowerCase()}, with the NIL rules that apply at each.`} ctx={{ sport: sport.slug }}
  crumbs={[{ name: 'NIL rules', href: '/nil/' }, { name: 'Sports', href: '/nil/sports/' }, { name: sport.name, href: path }]}
  lede={`Schools in the network that offer ${sport.name.toLowerCase()}. Each school page has the rules, disclosure steps and contacts.`}>
  <h2 class="sec">Browse</h2>
  <ul class="dir">{schools.filter((s) => s.path).map((s) => <li><a class="card" href={s.path}><h3>{s.name}</h3><p>{s.institution_type === 'college' ? 'College' : 'High school'}</p></a></li>)}</ul>
</Simple>
