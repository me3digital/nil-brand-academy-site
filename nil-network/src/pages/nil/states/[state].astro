---
import Base from '../../../layouts/Base.astro';
import Chip from '../../../components/Chip.astro';
import Refs from '../../../components/Refs.astro';
import Matrix from '../../../components/Matrix.astro';
import Scenarios from '../../../components/Scenarios.astro';
import SourceList from '../../../components/SourceList.astro';
import Cta from '../../../components/Cta.astro';
import { getStates, getStateHub, getPage, getInstitutions, pageIndexable, fmtDate } from '../../../lib/data.mjs';
import { SITE } from '../../../lib/site.mjs';
export async function getStaticPaths() { return (await getStates()).map((s) => ({ params: { state: s.slug } })); }
const hub = await getStateHub(Astro.params.state);
const { state, levels, changeLog, watch, bodies, sources, checked } = hub;
const page = await getPage(`/nil/states/${state.slug}/`);
const indexable = await pageIndexable(page.path);
const colleges = await getInstitutions(state.id, 'college');
const highSchools = await getInstitutions(state.id, 'high_school');
const crumbs = [{ name: 'NIL rules', href: '/nil/' }, { name: 'States', href: '/nil/states/' }, { name: state.name, href: page.path }];
const hs = levels.high_school, col = levels.college;
const T = (lv, slug) => lv.topics.find((t) => t.slug === slug);
const hsStatus = T(hs, 'nil-allowed'), colStatus = T(col, 'nil-allowed');
const disc = (lv) => (T(lv, 'disclosure-required')?.layers || []).filter((l) => l.disclosure);
const n = (url) => sources.find((s) => s.url === url)?.n;
const jsonld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: page.h1, url: SITE + page.path, description: page.meta_description, dateModified: String(checked),
  about: { '@type': 'State', name: state.name } }];
const keyTopics = (lv, slugs) => slugs.map((s) => T(lv, s)).filter(Boolean);
---
<Base title={page.title} description={page.meta_description} path={page.path} indexable={indexable} pageType="state_hub" crumbs={crumbs} jsonld={jsonld} ctx={{ state: state.code }}>
  <section class="hero"><div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol></nav>
    <div class="eyebrow">State NIL hub</div>
    <h1>{page.h1}</h1>
    <p class="lede">High school and college athletes in {state.name} can both earn NIL money, under two different rulebooks. High school athletes follow FHSAA Bylaw 9.9. College athletes follow NCAA rules, NIL Go reporting and a short Florida statute.</p>
    <div class="meta"><span class="pill warn">Sources checked {fmtDate(checked)} &middot; human verification pending</span>{bodies.map((b) => <span class="pill">{b.short_name}</span>)}</div>
  </div></section>
  <nav class="jump" aria-label="On this page"><div class="wrap">
    <a href="#glance">At a glance</a><a href="#high-school">High school rules</a><a href="#college">College rules</a><a href="#schools">Find your school</a><a href="#changes">Changes</a><a href="#sources">Sources</a>
  </div></nav>
  <div class="wrap">
  <section class="block" id="glance">
    <h2 class="sec">{state.name} NIL at a glance</h2>
    <div class="grid2">
      <div class="card can"><h3>High school athletes <Chip answer={hsStatus.answer} /></h3>
        <ul class="plain">
          {keyTopics(hs, ['nil-allowed', 'disclosure-required', 'school-logos-marks', 'collectives', 'school-staff-involvement', 'contract-length']).map((t) => <li><b>{t.label}.</b> {t.lead.summary} <Refs layer={t.lead} sources={sources} /></li>)}
        </ul>
        <p><a class="ref" href="#high-school">All high school rules</a></p>
      </div>
      <div class="card can"><h3>College athletes <Chip answer={colStatus.answer} /></h3>
        <ul class="plain">
          {keyTopics(col, ['nil-allowed', 'disclosure-required', 'deal-review', 'agents', 'school-logos-marks', 'nil-education']).map((t) => <li><b>{t.label}.</b> {t.lead.summary} <Refs layer={t.lead} sources={sources} /></li>)}
        </ul>
        <p><a class="ref" href="#college">All college rules</a></p>
      </div>
    </div>
    <h3 class="h3">Who makes the rules in {state.name}</h3>
    <ul class="plain">{bodies.map((b) => <li><b>{b.name}.</b> {b.description} <a class="ref" href={b.website_url} rel="noopener nofollow" target="_blank">Official site</a></li>)}</ul>
  </section>

  {[['high-school', 'High school athletes', hs, 'high_school'], ['college', 'College athletes', col, 'college']].map(([id, label, lv, level]) => (
    <section class="block" id={id}>
      <h2 class="sec">{label}: {state.name} rules</h2>
      <p class="sub">{level === 'high_school' ? 'These rules apply at every FHSAA member school. A school or district can add its own, which is what the school pages cover.' : 'These rules apply at every Florida Division I school. Each school adds its own rules on logos, gear and prohibited categories, which is what the school pages cover.'}</p>
      {disc(lv).map((l) => (
        <div class="disc-card">
          <div class="head">Disclosure: {l.issuer_name} <span>&middot; {l.citation}</span></div>
          <div class="cell"><p class="lbl">What</p><p>{l.disclosure.what}</p></div>
          <div class="cell"><p class="lbl">Who receives it</p><p>{l.disclosure.recipient}</p></div>
          <div class="cell"><p class="lbl">When</p><p>{l.disclosure.deadline_text}</p></div>
          <div class="foot">{l.disclosure.form_url && <a class="ref" href={l.disclosure.form_url} rel="noopener nofollow" target="_blank">{l.disclosure.form_name} (PDF)</a>}{l.disclosure.platform_url && <a class="ref" href={l.disclosure.platform_url} rel="noopener nofollow" target="_blank">{l.disclosure.platform_name}</a>} <Refs layer={l} sources={sources} /></div>
        </div>
      ))}
      <Matrix categories={lv.categories} sources={sources} caption={`${state.name} NIL rules for ${label.toLowerCase()}`} idPrefix={`${id}-`} />
      <h3 class="h3">Can I do this?</h3>
      <Scenarios scenarios={lv.scenarios} sources={sources} idPrefix={`${id}-`} />
    </section>
  ))}

  <section class="block" id="schools">
    <h2 class="sec">Find your school</h2>
    <p class="sub">School pages add what the statewide rules leave open: the school's own policy, who to ask, and local detail.</p>
    <ul class="dir">
      {[...colleges, ...highSchools].filter((i) => i.path).map((i) => <li><a class="card" href={i.path}><h3>{i.name}</h3><p>{i.city}, {state.name} &middot; {i.institution_type === 'college' ? 'College' : 'High school'}</p></a></li>)}
    </ul>
    <p style="margin-top:16px"><a class="ref" href={`/nil/${state.slug}/colleges/`}>All {state.name} colleges</a> &nbsp;&middot;&nbsp; <a class="ref" href={`/nil/${state.slug}/high-schools/`}>All {state.name} high schools</a></p>
  </section>

  <section class="block" id="changes">
    <h2 class="sec">What changed, and what we are watching</h2>
    <div class="tablewrap" tabindex="0" role="region" aria-label="Rule change history"><table class="log">
      <thead><tr><th scope="col">Date</th><th scope="col">Rule maker</th><th scope="col">What changed</th></tr></thead>
      <tbody>{changeLog.map((c) => <tr><td>{fmtDate(c.changed_on)}</td><td>{c.issuer}</td><td>{c.summary} {c.source_url && <a class="ref" href={c.source_url} rel="noopener nofollow" target="_blank">View source</a>}</td></tr>)}</tbody>
    </table></div>
    {watch.map((w) => <div class="note"><b>Watching: {w.title}.</b> {w.status_text} {w.summary} <span class="cite">As of {fmtDate(w.as_of)}</span> {w.source_url && <a class="ref" href={w.source_url} rel="noopener nofollow" target="_blank">View source</a>}</div>)}
  </section>

  <section class="block" id="sources">
    <h2 class="sec">Sources</h2>
    <p class="sub">Every rule on this page traces to one of these. <a class="ref" href="/nil/how-we-verify/">How we verify</a>.</p>
    <SourceList sources={sources} checked={checked} />
  </section>
  <section class="block"><Cta pageType="state_hub" level="both" /></section>
  </div>
</Base>
