# Repo-wide ignore rules. Source files, migrations and configuration are never ignored.

# secrets and credentials: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets.*

# dependencies, build output, temp files, logs
node_modules/
dist/
.astro/
tmp/
*.tmp
*.log
npm-debug.log*
logs/

# local database files, private backups and exports
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.bundle
backups/
exports/
_backup_and_preflight/

# platform local state
.netlify/
supabase/.temp/
supabase/.branches/

# IDE and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
